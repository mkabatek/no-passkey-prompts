{
  "manifest_version": 3,
  "name": "No passkey creation prompts",
  "version": "1.0",
  "description": "Rejects navigator.credentials.create() passkey requests on every site.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["block.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
